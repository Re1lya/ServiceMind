APP_NAME=ServiceMind Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Option 1: provide a full SQLAlchemy URL directly.
DATABASE_URL=

# Option 2: keep using split MySQL variables.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=servicemind

# Optional: provide a full Redis URL directly.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# OpenAI-compatible provider settings.
# DeepSeek example:
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=your_api_key
LLM_MODEL_NAME=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_STRIP_THINKING=true

# Ollama Qwen example:
# LLM_API_BASE=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL_NAME=qwen3:8b
# LLM_TIMEOUT_SECONDS=120
# LLM_STRIP_THINKING=true

# Optional dedicated embedding endpoint. Leave empty to reuse the LLM settings.
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_TIMEOUT_SECONDS=60
